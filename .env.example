# 复制为项目根目录 .env 后按需修改
# SQLite，相对路径相对仓库根；生产可写绝对路径如 file:/data/node-apps/basketball_drill/data/basketball.db
DATABASE_URL=file:./data/basketball.db

JWT_ACCESS_SECRET=change-me-to-long-random-string

# 分享页链接前缀（生产: https://basketball.itorange.online）
PUBLIC_APP_URL=http://localhost:5173

# 找回密码邮件（生产环境必填；示例：SMTP_HOST=smtp.example.com）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 示例：MAIL_FROM=Greenfighter <no-reply@example.com>
MAIL_FROM=

# 仅限本机开发使用；预发与生产必须保持 false，通过 SMTP 发送
PASSWORD_RESET_LOG_LINKS=true

# 重置链接有效期与同一账户发送冷却
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# API 监听（开发本机；生产 PM2 + Nginx 反代见 docs/deploy-tencent.md，默认 3002）
PORT=3002
HOST=0.0.0.0
